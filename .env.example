# Copy to .env and fill in. .env is gitignored; never commit real values.
# Run `uv run offer-engine check-env` to see which keys are set.

# Offer Bot token from BotFather (required)
OFFER_BOT_TOKEN=
# Offer Bot username without the @ (required)
OFFER_BOT_USERNAME=
# Customer Bots as username:token pairs, comma-separated, e.g. alice_bot:123:ABC,bob_bot:456:DEF
CUSTOMER_BOTS=
# Anthropic API key (required)
ANTHROPIC_API_KEY=
# Claude model ID for the offer agent; look up current IDs with the claude-api skill
OFFER_AGENT_MODEL=
# Claude model ID for fast, cheap calls (Customer Bots, offline runs)
FAST_AGENT_MODEL=
# SQLite database file (default data/offer_engine.db)
DB_PATH=
# Random seed for the generator and simulator (default 7)
SEED=
# Password for the marketing console (optional; empty means no password)
CONSOLE_PASSWORD=
# Claude calls: live (default), replay (play demo/agent_recordings.jsonl, call Claude only for a missing answer)
# or record (call Claude and add each answer to the recordings)
AGENT_MODE=
# Seed for repeatable Offer codes in the demo (optional; empty means random codes)
DEMO_SEED=
